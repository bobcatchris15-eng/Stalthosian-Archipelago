{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stalthosian-archipelago.invalid/contracts/research-record.schema.json",
  "title": "Stalthos research record",
  "description": "Output of `stalthos research_species` (pipeline stage 1). Normalizes the references already present in a definition into an offline, auditable record. No network access, no scraping: a locator is only ever inspected for shape and, for local paths, for existence.",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "species_id",
    "definition_path",
    "definition_sha256",
    "seed",
    "common_names",
    "uncertainty",
    "references",
    "unresolved",
    "usage_rights_summary",
    "warnings",
    "tool"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "record_type": { "enum": ["research-record"] },
    "species_id": { "type": "string", "minLength": 3 },
    "definition_path": { "type": "string", "minLength": 1 },
    "definition_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "definition_kind": { "type": ["string", "null"] },
    "generator": { "type": ["string", "null"] },
    "morphology_family": { "type": ["string", "null"] },
    "seed": { "type": "integer" },
    "created_at": { "type": "string", "format": "date-time" },
    "common_names": {
      "type": "object",
      "required": ["primary"],
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "working": { "type": "boolean" },
        "aka": { "type": "array", "items": { "type": "string" } }
      }
    },
    "habitat_tags": { "type": "array", "items": { "type": "string" } },
    "uncertainty": {
      "description": "Effective evidence tier of the record: the declared file tier, degraded to 'unverified' by any reference whose usage rights could not be established.",
      "enum": ["documented", "comparative_inference", "biomechanical_plausibility", "speculative", "unverified"]
    },
    "declared_uncertainty": {
      "type": ["string", "null"],
      "enum": ["documented", "comparative_inference", "biomechanical_plausibility", "speculative", null]
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/normalized_reference" }
    },
    "unresolved": {
      "description": "Locators this offline stage could not resolve. Never silently dropped.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reference_id", "reason"],
        "additionalProperties": false,
        "properties": {
          "reference_id": { "type": "string", "minLength": 1 },
          "locator": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "usage_rights_summary": {
      "type": "object",
      "required": ["total", "verified", "unverified", "redistributable"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "verified": { "type": "integer", "minimum": 0 },
        "unverified": { "type": "integer", "minimum": 0 },
        "redistributable": { "type": "integer", "minimum": 0 },
        "by_rights": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "applies_to", "license"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "applies_to": { "type": "string" },
          "license": { "type": "string" },
          "holder": { "type": "string" },
          "url": { "type": "string" },
          "redistribution_notes": { "type": "string" }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "tool": {
      "type": "object",
      "required": ["name", "version", "offline"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "offline": { "const": true, "description": "Always true: this stage performs no network access." },
        "python": { "type": "string" }
      }
    }
  },
  "$defs": {
    "normalized_reference": {
      "type": "object",
      "required": ["id", "kind", "locator", "locator_type", "usage_rights", "uncertainty_tier", "resolved"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "uncertainty_tier": {
          "description": "Per-reference evidence tier. 'unverified' whenever usage rights could not be established.",
          "enum": ["documented", "comparative_inference", "biomechanical_plausibility", "speculative", "unverified"]
        },
        "locator": { "type": "string", "minLength": 1 },
        "locator_type": {
          "description": "How the locator was classified offline.",
          "enum": ["local_path", "url", "doi", "identifier", "text"]
        },
        "normalized_locator": { "type": ["string", "null"] },
        "title": { "type": ["string", "null"] },
        "usage_rights": {
          "type": "string",
          "enum": ["cc0", "cc-by", "cc-by-sa", "public_domain", "own_work", "permission_granted", "internal_reference", "unknown", "absent"]
        },
        "usage_rights_verified": { "type": "boolean" },
        "redistributable": { "type": "boolean" },
        "confidence": { "type": ["string", "null"] },
        "supports": { "type": "array", "items": { "type": "string" } },
        "exists": { "type": ["boolean", "null"], "description": "Only meaningful for local_path locators; null when not checkable offline." },
        "resolved": { "type": "boolean", "description": "True when this stage could fully establish locator and usage rights." },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}